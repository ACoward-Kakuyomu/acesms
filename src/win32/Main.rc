    COMBOBOX IDC_SHORTCUT_BASE, 100, 9, 119, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Load state", -1, 9, 29, 87, 10
    COMBOBOX IDC_SHORTCUT_BASE+1, 100, 26, 119, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Previous slot", -1, 9, 46, 87, 10
    COMBOBOX IDC_SHORTCUT_BASE+2, 100, 43, 119, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Next slot", -1, 9, 63, 87, 10
    COMBOBOX IDC_SHORTCUT_BASE+3, 100, 60, 119, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Fast forward", -1, 9, 80, 87, 10
    COMBOBOX IDC_SHORTCUT_BASE+4, 100, 77, 119, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Fullscreen", -1, 9, 97, 87, 10
    COMBOBOX IDC_SHORTCUT_BASE+5, 100, 94, 119, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    DEFPUSHBUTTON "OK", IDOK, 112, 122, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 169, 122, 50, 14
END

IDD_MANAGE_STATES DIALOGEX 0, 0, 370, 195
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Manage states"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Saved states", -1, 8, 8, 354, 9
    LISTBOX IDC_STATE_LIST, 8, 20, 354, 101, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_STATE_DETAILS, 8, 126, 354, 10
