#include <windows.h>
#include <commctrl.h>
#include "Resource.h"
#include "VersionResource.h"

IDI_ACESMS ICON "acesms.ico"

1 VERSIONINFO
FILEVERSION ACESMS_RESOURCE_VERSION
PRODUCTVERSION ACESMS_RESOURCE_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ACoward"
            VALUE "FileDescription", "acesms - Sega 8-bit emulator"
            VALUE "FileVersion", ACESMS_RESOURCE_VERSION_STRING
            VALUE "InternalName", "acesms"
            VALUE "LegalCopyright", "Copyright (c) 2026 ACoward"
            VALUE "OriginalFilename", "acesms.exe"
            VALUE "ProductName", "acesms"
            VALUE "ProductVersion", ACESMS_RESOURCE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open ROM...", IDM_FILE_OPEN
        MENUITEM "Edit ROM settings...", IDM_EDIT_ROM
        MENUITEM "&Manage states...", IDM_MANAGE_STATES
        POPUP "State slot"
        BEGIN
            MENUITEM "1  (Empty)", IDM_STATE_SLOT_BASE
        END
        MENUITEM SEPARATOR
        MENUITEM "&Settings...", IDM_SETTINGS
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&Emulation"
    BEGIN
        MENUITEM "Host &pause\tSpace", IDM_HOST_PAUSE
        MENUITEM "&Mute", IDM_MUTE
        MENUITEM "&Fast forward\tF2", IDM_FAST_FORWARD
        MENUITEM "Full&screen\tAlt+Enter", IDM_FULLSCREEN
        MENUITEM SEPARATOR
        MENUITEM "Memory Search...\tF9", IDM_MEMORY_SEARCH
        MENUITEM "Cheat Editor...\tAlt+F9", IDM_CHEAT_EDITOR
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Pixel aspect 1:1", IDM_ASPECT_SQUARE
        MENUITEM "&Screen aspect 4:3", IDM_ASPECT_4_3
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...", IDM_HELP_ABOUT
        MENUITEM "ROM &information...", IDM_HELP_ROM_INFO
    END
END

IDD_REGISTER_ROM DIALOGEX 0, 0, 370, 234
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Register ROM"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_ROM_INFO, 8, 8, 354, 61
    LTEXT "&Name", -1, 8, 75, 93, 9
    EDITTEXT IDC_ROM_NAME, 104, 72, 258, 14, ES_AUTOHSCROLL
    LTEXT "&Machine", -1, 8, 92, 93, 9
    COMBOBOX IDC_ROM_MACHINE, 104, 89, 258, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "&Video", -1, 8, 109, 93, 9
    COMBOBOX IDC_ROM_VIDEO, 104, 106, 258, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Ma&pper", -1, 8, 126, 93, 9
    COMBOBOX IDC_ROM_MAPPER, 104, 123, 258, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Cartridge &RAM", -1, 8, 143, 93, 9
    COMBOBOX IDC_ROM_RAM, 104, 140, 258, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX "&FM (SMS NTSC)", IDC_ROM_FM, 8, 159, 93, 10
    COMBOBOX IDC_ROM_BACKEND, 104, 156, 258, 85, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "FM &interpolation", -1, 8, 176, 93, 9
    COMBOBOX IDC_ROM_INTERPOLATION, 104, 173, 258, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "", IDC_ROM_ERROR, 8, 192, 354, 18
    LTEXT "", IDC_ROM_SRAM_CAPACITY, 8, 217, 106, 9
    PUSHBUTTON "Clear SRAM...", IDC_ROM_CLEAR_SRAM, 119, 214, 86, 14
    DEFPUSHBUTTON "Register and open", IDOK, 226, 214, 78, 14
    PUSHBUTTON "Cancel", IDCANCEL, 312, 214, 50, 14
END

IDD_ROM_IMPACT DIALOGEX 0, 0, 370, 206
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Review ROM changes"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_ROM_IMPACT, 8, 8, 354, 165, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Apply changes", IDOK, 226, 183, 78, 14
    PUSHBUTTON "Cancel", IDCANCEL, 312, 183, 50, 14
END

IDD_CHEATS DIALOGEX 0, 0, 352, 241
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Memory Search and Cheats"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_CHEAT_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 7, 6, 338, 206
    LTEXT "&Width", IDC_SEARCH_WIDTH_LABEL, 15, 28, 25, 10
    COMBOBOX IDC_SEARCH_WIDTH, 42, 25, 44, 54, CBS_DROPDOWNLIST | WS_TABSTOP
    COMBOBOX IDC_SEARCH_CONDITION, 90, 25, 74, 76, CBS_DROPDOWNLIST | WS_TABSTOP
    EDITTEXT IDC_SEARCH_VALUE, 168, 25, 65, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "&Filter", IDC_SEARCH_FILTER, 237, 25, 43, 14
    PUSHBUTTON "&New Search", IDC_SEARCH_NEW, 284, 25, 52, 14
    CONTROL "", IDC_SEARCH_RESULTS, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL, 15, 46, 321, 143
    LTEXT "Double-click a result to edit a cheat.", IDC_SEARCH_HELP, 15, 195, 321, 10

    LISTBOX IDC_CHEAT_LIST, 15, 25, 321, 86, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Name", IDC_CHEAT_NAME_LABEL, 15, 120, 38, 10
    EDITTEXT IDC_CHEAT_NAME, 56, 117, 280, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "A&ddress", IDC_CHEAT_ADDRESS_LABEL, 15, 140, 38, 10
    EDITTEXT IDC_CHEAT_ADDRESS, 56, 137, 61, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Width", IDC_CHEAT_WIDTH_LABEL, 132, 140, 32, 10
    COMBOBOX IDC_CHEAT_WIDTH, 167, 137, 48, 54, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "&Value", IDC_CHEAT_VALUE_LABEL, 228, 140, 30, 10
    EDITTEXT IDC_CHEAT_VALUE, 261, 137, 75, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "&Enabled", IDC_CHEAT_ENABLED, 15, 158, 60, 13, WS_TABSTOP
    AUTOCHECKBOX "Al&ways Apply", IDC_CHEAT_ALWAYS, 81, 158, 84, 13, WS_TABSTOP
    PUSHBUTTON "Add", IDC_CHEAT_ADD, 15, 177, 42, 15
    PUSHBUTTON "&Update", IDC_CHEAT_UPDATE, 61, 177, 47, 15
    PUSHBUTTON "&Delete", IDC_CHEAT_DELETE, 112, 177, 45, 15
    PUSHBUTTON "&Apply", IDC_CHEAT_APPLY, 161, 177, 45, 15
    PUSHBUTTON "&Save Cheats", IDC_CHEAT_SAVE, 267, 177, 69, 15
    PUSHBUTTON "&Import...", IDC_CHEAT_IMPORT, 15, 194, 58, 14
    PUSHBUTTON "E&xport...", IDC_CHEAT_EXPORT, 77, 194, 58, 14
    LTEXT "", IDC_CHEAT_STATUS, 8, 216, 255, 20
    PUSHBUTTON "Resume (F9)", IDCANCEL, 269, 219, 76, 15
END

IDD_SETTINGS DIALOGEX 0, 0, 282, 224
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 7, 6, 268, 177
    LTEXT "&Machine", IDC_ROM_LABEL_BASE, 16, 32, 88, 9
    COMBOBOX IDC_ROM_MACHINE, 108, 29, 157, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "&Video", IDC_ROM_LABEL_BASE+1, 16, 50, 88, 9
    COMBOBOX IDC_ROM_VIDEO, 108, 47, 157, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Ma&pper", IDC_ROM_LABEL_BASE+2, 16, 68, 88, 9
    COMBOBOX IDC_ROM_MAPPER, 108, 65, 157, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Cartridge &RAM", IDC_ROM_LABEL_BASE+3, 16, 86, 88, 9
    COMBOBOX IDC_ROM_RAM, 108, 83, 157, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "&Copier header", IDC_ROM_LABEL_BASE+4, 16, 104, 88, 9
    COMBOBOX IDC_ROM_COPIER_HEADER, 108, 101, 157, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX "&FM (SMS NTSC)", IDC_ROM_FM, 16, 122, 88, 10
    COMBOBOX IDC_ROM_BACKEND, 108, 119, 157, 85, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "FM &interpolation", IDC_ROM_LABEL_BASE+5, 16, 140, 88, 9
    COMBOBOX IDC_ROM_INTERPOLATION, 108, 137, 157, 70, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Sega RAM is saved. Codemasters RAM is volatile.", IDC_ROM_LABEL_BASE+6, 16, 159, 249, 10
    LTEXT "&Player", IDC_PAD_LABEL_PLAYER, 16, 32, 46, 9
    COMBOBOX IDC_PAD_PLAYER, 65, 29, 62, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Input &source", IDC_PAD_LABEL_SOURCE, 132, 32, 61, 9
    COMBOBOX IDC_PAD_SOURCE, 194, 29, 71, 65, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "XInput &slot", IDC_PAD_LABEL_SLOT, 16, 51, 88, 9
    COMBOBOX IDC_PAD_SLOT, 108, 48, 47, 73, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "", IDC_PAD_STATUS, 159, 51, 106, 9
    PUSHBUTTON "XInput shortcuts...", IDC_PAD_SHORTCUTS, 108, 75, 157, 14
    LTEXT "Up", IDC_PAD_LABEL_KEY_BASE, 16, 52, 88, 9
    EDITTEXT IDC_PAD_KEY_BASE, 108, 49, 157, 13, ES_READONLY | WS_TABSTOP
    LTEXT "Down", IDC_PAD_LABEL_KEY_BASE+1, 16, 68, 88, 9
    EDITTEXT IDC_PAD_KEY_BASE+1, 108, 65, 157, 13, ES_READONLY | WS_TABSTOP
    LTEXT "Left", IDC_PAD_LABEL_KEY_BASE+2, 16, 84, 88, 9
    EDITTEXT IDC_PAD_KEY_BASE+2, 108, 81, 157, 13, ES_READONLY | WS_TABSTOP
    LTEXT "Right", IDC_PAD_LABEL_KEY_BASE+3, 16, 100, 88, 9
    EDITTEXT IDC_PAD_KEY_BASE+3, 108, 97, 157, 13, ES_READONLY | WS_TABSTOP
    LTEXT "Button 1", IDC_PAD_LABEL_KEY_BASE+4, 16, 116, 88, 9
    EDITTEXT IDC_PAD_KEY_BASE+4, 108, 113, 157, 13, ES_READONLY | WS_TABSTOP
    COMBOBOX IDC_PAD_BUTTON_BASE, 108, 113, 157, 75, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Button 2", IDC_PAD_LABEL_KEY_BASE+5, 16, 132, 88, 9
    EDITTEXT IDC_PAD_KEY_BASE+5, 108, 129, 157, 13, ES_READONLY | WS_TABSTOP
    COMBOBOX IDC_PAD_BUTTON_BASE+1, 108, 129, 157, 75, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Rapid fire 1", IDC_PAD_LABEL_KEY_BASE+6, 16, 148, 88, 9
    EDITTEXT IDC_PAD_KEY_BASE+6, 108, 145, 112, 13, ES_READONLY | WS_TABSTOP
    PUSHBUTTON "Clear", IDC_PAD_CLEAR_RAPID_BASE, 225, 145, 40, 13
    COMBOBOX IDC_PAD_BUTTON_BASE+2, 108, 145, 157, 75, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Rapid fire 2", IDC_PAD_LABEL_KEY_BASE+7, 16, 164, 88, 9
    EDITTEXT IDC_PAD_KEY_BASE+7, 108, 161, 112, 13, ES_READONLY | WS_TABSTOP
    PUSHBUTTON "Clear", IDC_PAD_CLEAR_RAPID_BASE+1, 225, 161, 40, 13
    COMBOBOX IDC_PAD_BUTTON_BASE+3, 108, 161, 157, 75, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "", IDC_PAD_ERROR, 7, 186, 268, 11
    LTEXT "", IDC_ROM_ERROR, 7, 186, 268, 11
    DEFPUSHBUTTON "OK", IDOK, 168, 201, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 225, 201, 50, 14
END

IDD_XINPUT_SHORTCUTS DIALOGEX 0, 0, 228, 145
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Player 1 XInput Shortcuts"
FONT 9, "Segoe UI"
BEGIN
